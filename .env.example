# Copy to .env.local (gitignored) and fill in. Placeholders only: never commit keys.
#
# Local: run `npx supabase status -o env` and use API_URL and ANON_KEY.
# Production: Supabase dashboard, Project Settings, API (Project URL and the
# public anon key). These two are public by design; row-level security protects
# the data. The service-role key does NOT go here: it is only passed on the
# command line to scripts/create-admin.mjs.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from `npx supabase status -o env`>
