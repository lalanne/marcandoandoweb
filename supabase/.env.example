# Fake values for the Google provider in local Supabase (spec 005). Copy this file
# to supabase/.env (gitignored) before `npx supabase start`. They are NOT real
# Google credentials: nothing in local development or CI talks to Google.
# The real client ID and secret live only in the Supabase dashboard.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=fake-google-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=fake-google-client-secret
